{{- /*
===============================================================================
LOCAL OVERRIDE OF UPSTREAM dot_agents/skills/review/SKILL.md
Upstream copy: .chezmoitemplates/review/upstream.SKILL.md
===============================================================================
*/ -}}
{{- $upstream := includeTemplate "review/upstream.SKILL.md" . -}}
{{- /* Rename the skill so it does not clash with project-level review skills; require exactly one upstream name line before replacing it. */ -}}
{{- $name := "\nname: review\n" -}}
{{- if ne (len (splitList $name $upstream)) 2 }}{{ fail "review/upstream.SKILL.md no longer contains exactly one `name: review` line; update the override in dot_agents/skills/liby-review/SKILL.md.tmpl" }}{{ end -}}
{{ replace $name "\nname: liby-review\n" $upstream -}}
