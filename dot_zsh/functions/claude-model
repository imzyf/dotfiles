# claude-model: pick a model from a list, then launch the gateway with it.
#
# claude-model [args...]   Show the picker, then run: claude --gateway --model <picked> args...
#
# The list comes from $XDG_CONFIG_HOME/claude-code/models, one model id per
# line, ignoring blank lines and # comments. The last pick is remembered in
# $XDG_STATE_HOME/claude-code/last-model and preselected on the next call.

emulate -L zsh

[[ -t 0 && -t 1 ]] || { print -u2 "claude-model: requires an interactive terminal"; return 1 }

local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code"
local models_file="$config_dir/models"

[[ -f $models_file ]] || { print -u2 "claude-model: missing $models_file"; return 1 }

local -a models=()
local line
while IFS= read -r line || [[ -n $line ]]; do
  models+=(${=line%%\#*})
done < $models_file
(( $#models )) || { print -u2 "claude-model: no model ids in $models_file"; return 1 }

local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/claude-code"
local state_file="$state_dir/last-model"
local last=
[[ -f $state_file ]] && IFS= read -r last < $state_file

local n=$#models
local selected=${models[(I)$last]} cursor
(( selected )) || selected=1
(( selected-- ))
cursor=$selected

local key seq first=1
local teardown=$'\e['$n$'A\e[J\e[?25h'
local i marker

print -n '\e[?25l'

while true; do
  (( first )) || print -n $'\e['$n$'A'
  first=0
  for (( i = 0; i < n; i++ )); do
    (( i == selected )) && marker='●' || marker='○'
    line="  $marker ${models[i+1]}"
    if (( i == cursor )); then
      print -rn -- $'\e[48;5;237m'"$line"$'\e[K\e[0m'
    else
      print -rn -- "$line"$'\e[K'
    fi
    print
  done

  read -rsk1 key
  case $key in
    $'\e')
      seq=; read -rsk1 -t 0.05 seq 2>/dev/null
      if [[ -z $seq ]]; then
        print -n $teardown
        return 1
      fi
      seq=; read -rsk1 -t 0.05 seq 2>/dev/null
      [[ $seq == A ]] && (( cursor = (cursor + n - 1) % n ))
      [[ $seq == B ]] && (( cursor = (cursor + 1) % n ))
      ;;
    ' '|$'\n')
      selected=$cursor
      break
      ;;
    $'\x03')
      print -n $teardown
      return 130
      ;;
  esac
done

print -n $teardown

local model=$models[selected+1]
mkdir -p $state_dir && print -r -- $model > $state_file

claude --gateway --model $model "$@"
