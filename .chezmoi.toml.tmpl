encryption = "gpg"

[data.private]
  rcGatewayBaseUrl = {{ promptStringOnce . "private.rcGatewayBaseUrl" "OpenAI-compatible API base URL (ending in /v1)" | quote }}
  gitlabEmail = {{ promptStringOnce . "private.gitlabEmail" "Private GitLab email" | quote }}
  gitlabHost = {{ promptStringOnce . "private.gitlabHost" "Private GitLab host" | trimPrefix "https://" | trimSuffix "/" | quote }}
  gitlabName = {{ promptStringOnce . "private.gitlabName" "Private GitLab name" | quote }}
  # No private npm registry here. The sandbox allowlist renders this host as is;
  # `.invalid` is a reserved TLD that never resolves. Replace with upstream's
  # prompt when a registry is needed.
  npmHost = "npm.invalid"
  # No Tailscale here. The sandbox allowlist renders `*.invalid`, a reserved
  # TLD that never resolves; replace with upstream's prompt when a tailnet exists.
  tailnetDomain = "invalid"

[edit]
  args = ["--wait"]
  command = "code"

[gpg]
  # The bootstrap shell has no Homebrew PATH when chezmoi first decrypts.
  command = "/opt/homebrew/bin/gpg"
  args = ["--quiet"]
  recipients = ["19084855608DB9D5"]

[merge]
  command = "bash"
  args = [
    "-c",
    {{ printf "%q" `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` }},
  ]
