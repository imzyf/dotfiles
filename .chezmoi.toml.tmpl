encryption = "age"

[data.work]
  name = {{ promptStringOnce . "work.name" "Work name" | quote }}
  email = {{ promptStringOnce . "work.email" "Work email" | quote }}
  gitlabHost = {{ promptStringOnce . "work.gitlabHost" "Work GitLab host" | quote }}

[age]
  identity = {{ (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt") | quote }}
  # Public half of the age key pair. Safe to publish. Run `make age-key` to create one.
  recipient = "AGE_RECIPIENT_PLACEHOLDER"

[edit]
  args = ["--wait"]
  command = "code"

[merge]
  command = "bash"
  args = [
    "-c",
    {{ printf "%q" `cp {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf "%s.base" .Target | quote }} {{ .Source | quote }}` }},
  ]
