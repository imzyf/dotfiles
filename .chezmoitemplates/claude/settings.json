{{- /*
===============================================================================
LOCAL OVERRIDE OF UPSTREAM .chezmoitemplates/claude/settings.json
Upstream copy: .chezmoitemplates/claude/upstream.settings.json
Merged into live settings by dot_claude/modify_private_settings.json.
===============================================================================
*/ -}}

{{- $settings := includeTemplate "claude/upstream.settings.json" . | fromJson -}}

{{- /* Clear upstream hooks except rexume's, which `rexume install` also registers, and the
      compaction hooks; keep the managed key so applying replaces existing live hooks. */ -}}
{{- $keptCommands := list "~/.claude/hooks/pre-compact-instructions.sh" "~/.claude/hooks/post-compact-reminder.sh" -}}
{{- $found := dict -}}
{{- $hooks := dict -}}
{{- range $event, $groups := $settings.hooks -}}
  {{- $keptGroups := list -}}
  {{- range $groups -}}
    {{- $kept := list -}}
    {{- range .hooks -}}
      {{- if hasPrefix "rexume " .command -}}
        {{- $kept = append $kept . -}}
        {{- $_ := set $found "rexume" true -}}
      {{- else if has .command $keptCommands -}}
        {{- $kept = append $kept . -}}
        {{- $_ := set $found .command true -}}
      {{- end -}}
    {{- end -}}
    {{- if $kept -}}
      {{- $keptGroups = append $keptGroups (set (deepCopy .) "hooks" $kept) -}}
    {{- end -}}
  {{- end -}}
  {{- if $keptGroups -}}
    {{- $_ := set $hooks $event $keptGroups -}}
  {{- end -}}
{{- end -}}
{{- if not (hasKey $found "rexume") -}}
  {{- fail "claude/upstream.settings.json no longer registers rexume hooks; update the override in claude/settings.json" -}}
{{- end -}}
{{- range $keptCommands -}}
  {{- if not (hasKey $found .) -}}
    {{- fail (printf "claude/upstream.settings.json no longer registers %s; update the override in claude/settings.json" .) -}}
  {{- end -}}
{{- end -}}
{{- $_ := set $settings "hooks" $hooks -}}
{{ toPrettyJson $settings }}
