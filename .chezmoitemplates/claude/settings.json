{{- /* Upstream settings plus local overrides; dot_claude/modify_private_settings.json merges the result. */ -}}
{{- /* private.npmHost is gone from the chezmoi data: pass a placeholder, then drop it below. */ -}}
{{- $npmHost := "npm-host-removed.invalid" -}}
{{- $data := deepCopy . -}}
{{- $_ := set $data.private "npmHost" $npmHost -}}
{{- $settings := includeTemplate "claude/upstream.settings.json" $data | fromJson -}}
{{- $network := $settings.sandbox.network -}}
{{- if not (has $npmHost $network.allowedDomains) }}{{ fail "claude/upstream.settings.json no longer lists private.npmHost in sandbox.network.allowedDomains; update the override in claude/settings.json" }}{{ end -}}
{{- $_ := set $network "allowedDomains" (without $network.allowedDomains $npmHost) -}}
{{- $_ := set $settings "autoCompactWindow" 600000 -}}
{{ toPrettyJson $settings }}
