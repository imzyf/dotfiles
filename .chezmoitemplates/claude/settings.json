{{- /*
===============================================================================
LOCAL OVERRIDE OF UPSTREAM .chezmoitemplates/claude/settings.json
Upstream copy: .chezmoitemplates/claude/upstream.settings.json
Merged into live settings by dot_claude/modify_private_settings.json.
===============================================================================
*/ -}}

{{- /* Upstream still requires private.npmHost; supply a placeholder without changing shared template data. */ -}}
{{- $removedNpmHost := "npm-host-removed.invalid" -}}
{{- $upstreamData := deepCopy . -}}
{{- $_ := set $upstreamData.private "npmHost" $removedNpmHost -}}
{{- $settings := includeTemplate "claude/upstream.settings.json" $upstreamData | fromJson -}}

{{- /* Remove the retired private.npmHost entry from sandbox.network.allowedDomains. */ -}}
{{- $allowedDomains := $settings.sandbox.network.allowedDomains -}}
{{- if not (has $removedNpmHost $allowedDomains) -}}
  {{- fail "claude/upstream.settings.json no longer lists private.npmHost in sandbox.network.allowedDomains; update the override in claude/settings.json" -}}
{{- end -}}
{{- $_ := set $settings.sandbox.network "allowedDomains" (without $allowedDomains $removedNpmHost) -}}

{{- /* Clear upstream hooks except rexume's, which `rexume install` also registers; keep the
      managed key so applying replaces existing live hooks. */ -}}
{{- $hooks := dict -}}
{{- range $event, $groups := $settings.hooks -}}
  {{- $keptGroups := list -}}
  {{- range $groups -}}
    {{- $rexume := list -}}
    {{- range .hooks -}}
      {{- if hasPrefix "rexume " .command -}}
        {{- $rexume = append $rexume . -}}
      {{- end -}}
    {{- end -}}
    {{- if $rexume -}}
      {{- $keptGroups = append $keptGroups (set (deepCopy .) "hooks" $rexume) -}}
    {{- end -}}
  {{- end -}}
  {{- if $keptGroups -}}
    {{- $_ := set $hooks $event $keptGroups -}}
  {{- end -}}
{{- end -}}
{{- if not $hooks -}}
  {{- fail "claude/upstream.settings.json no longer registers rexume hooks; update the override in claude/settings.json" -}}
{{- end -}}
{{- $_ := set $settings "hooks" $hooks -}}
{{ toPrettyJson $settings }}
