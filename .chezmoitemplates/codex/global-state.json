{{- /*
===============================================================================
LOCAL OVERRIDE OF UPSTREAM .chezmoitemplates/codex/global-state.json
Upstream copy: .chezmoitemplates/codex/upstream.global-state.json
Merged into live state by dot_codex/modify_dot_codex-global-state.json.
===============================================================================
*/ -}}
{{- $state := includeTemplate "codex/upstream.global-state.json" . | fromJson -}}

{{- /* Leave these to the app: it saves the last choice from the home composer's Chat/Work
      switch and the review panel's diff filter, so managing them makes every switch drift. */ -}}
{{- $atoms := index $state "electron-persisted-atom-state" -}}
{{- range $key := list "home-composer-mode-v1" "last-explicit-review-diff-filter" -}}
  {{- if not (hasKey $atoms $key) -}}
    {{- fail (printf "codex/upstream.global-state.json no longer sets electron-persisted-atom-state.%s; update the override in codex/global-state.json" $key) -}}
  {{- end -}}
  {{- $_ := unset $atoms $key -}}
{{- end -}}
{{- $state | toPrettyJson }}
