# sync-upstream.sh 从上游 dotfiles 仓库同步的路径清单。
# 以 '!' 开头的行表示这个路径保留本地版本，不被覆盖。
# 排除规则匹配本地目标路径：'*'、'?' 和 '[...]' 只匹配单级路径，
# '**' 匹配零级或多级目录，也匹配以点开头的路径。
# 匹配到目录时，该目录下的所有内容也会被排除。
# '上游路径 > 本地路径' 表示把上游文件复制到另一个本地路径，
# 上游路径对应的本地文件保持不动。

!**/*.test.*

.chezmoiscripts/
!.chezmoiscripts/run_once_before_setup-case-sensitive-volume.py
!.chezmoiscripts/run_onchange_after_import-input-source-pro.sh.tmpl
!.chezmoiscripts/run_onchange_after_setup-apps.sh
!.chezmoiscripts/run_onchange_after_setup-macos-defaults.sh.tmpl

.chezmoitemplates/
.chezmoitemplates/codex/config.toml > .chezmoitemplates/codex/upstream.config.toml
.chezmoitemplates/claude/settings.json > .chezmoitemplates/claude/upstream.settings.json
.chezmoitemplates/git/github.config > .chezmoitemplates/git/upstream.github.config
!.chezmoitemplates/input-source-pro/

.github/dev-tools/
.github/CONCEPTS.md
.github/renovate.json

dot_agents/skills/deslop/
dot_agents/skills/draft/
dot_agents/skills/glab/
dot_agents/skills/gh/
dot_agents/skills/new-branch/
dot_agents/skills/set-goal/
dot_agents/skills/write-skill/

dot_claude/
dot_claude/CLAUDE.md.tmpl > .chezmoitemplates/claude/upstream.CLAUDE.md.tmpl

dot_codex/
!dot_codex/rules/snow.rules

dot_homebrew/

dot_config/git/
dot_config/git/config > .chezmoitemplates/git/upstream.config
dot_config/uv/

dot_proto/

dot_zsh/

private_dot_pi/

.chezmoiexternal.toml
AGENTS.md > .github/upstream.AGENTS.md
dot_zshenv > .chezmoitemplates/zsh/upstream.dot_zshenv
dot_zshrc > .chezmoitemplates/zsh/upstream.dot_zshrc
modify_dot_claude.json
