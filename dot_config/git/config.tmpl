{{- $upstream := includeTemplate "git/upstream.config" . -}}
{{- if not (regexMatch `(?s)\n\[include\]\n\s+path = github\.config\n+\[includeIf "gitdir:~/Code/GitLab/"\]\n\s+path = gitlab\.config\n+\[includeIf "gitdir:~/Code/"\]\n\s+path = performance\.config\n\z` $upstream) }}{{ fail "git/upstream.config no longer ends with the expected include block; update the override in dot_config/git/config.tmpl" }}{{ end -}}
{{ regexReplaceAllLiteral `(?s)\n\[include\].*\z` $upstream "" }}
[user]
  email = hi@zyf.im
  name = imzyf

[alias]
  co = checkout
  ps = push
  psf = push --force-with-lease
  psf-skip = push --force-with-lease -o ci.skip

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
  path = github.config

[includeIf "hasconfig:remote.*.url:https://github.com/*/**"]
  path = github.config

[includeIf "hasconfig:remote.*.url:git@{{ .private.gitlabHost }}:*/**"]
  path = gitlab.config

[includeIf "gitdir:~/Code/"]
  path = performance.config
